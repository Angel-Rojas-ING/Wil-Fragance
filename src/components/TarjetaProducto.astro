---
import Icono from './Icono.astro';
import { precio as fmt, normalizar } from '../lib/formato';
import { enlaceWhatsApp, mensajes } from '../datos/tienda';
import { rutaImagen, srcsetImagen, rutaPerfume, nombreCompleto, textoBusqueda, type Producto } from '../lib/catalogo';

interface Props {
  producto: Producto;
  prioridad?: boolean;
  tamanos?: string;
}
const { producto: p, prioridad = false, tamanos = '(min-width: 1024px) 23vw, (min-width: 640px) 31vw, 46vw' } = Astro.props;
const agotado = p.stock === 'agotado';
const datosAnadir = JSON.stringify({ id: p.id, slug: p.slug, nombre: p.nombre, marca: p.marca, precio: p.precio, imagen: rutaImagen(p.imagen, 400) });
---

<article
  class="group flex flex-col border border-arena bg-blanco p-3 pb-3.5 transition-colors duration-300 hover:border-piedra"
  data-producto
  data-id={p.id}
  data-genero={p.genero}
  data-tipo={normalizar(p.tipo)}
  data-marca={normalizar(p.marca)}
  data-precio={p.precio}
  data-nombre={normalizar(p.nombre)}
  data-busqueda={textoBusqueda(p)}
  data-destacado={p.destacado ? '1' : '0'}
  data-orden={p.id}
  data-agotado={agotado ? '1' : '0'}
>
  <a href={rutaPerfume(p)} class="block">
    <div class="arco arco--limpio" class:list={{ 'opacity-60': agotado }}>
      {agotado && <span class="insignia">Agotado</span>}
      <img
        src={rutaImagen(p.imagen, 400)}
        srcset={srcsetImagen(p.imagen)}
        sizes={tamanos}
        width="400"
        height="400"
        alt={nombreCompleto(p)}
        loading={prioridad ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={prioridad ? 'high' : 'auto'}
        transition:name={`foto-${p.slug}`}
      />
    </div>
    <h3 class="mt-3 text-[15px] font-semibold leading-snug tracking-[-0.01em] text-negro">{p.nombre}</h3>
    <p class="etiqueta mt-1 text-[10px] text-oro-oscuro">{p.marca}</p>
  </a>
  <p class="precio mt-2 text-[17px]"><small>RD$</small>{fmt(p.precio).replace('RD$', '')}</p>
  {agotado ? (
    <a
      href={enlaceWhatsApp(mensajes.avisame(nombreCompleto(p)))}
      target="_blank"
      rel="noopener"
      class="btn btn-borde mt-3 w-full px-2 text-[11px]"
    >
      <Icono nombre="whatsapp" tamano={16} />
      Avísame
    </a>
  ) : (
    <button type="button" class="btn btn-negro mt-3 w-full px-2 text-[11px]" data-anadir={datosAnadir}>
      <span data-texto-anadir>Añadir</span>
    </button>
  )}
</article>
