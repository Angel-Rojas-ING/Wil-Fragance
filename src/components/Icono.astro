---
/**
 * Iconos de trazo (1.6 px) dibujados a mano para no depender de librerías.
 * El de WhatsApp es relleno, como su marca.
 */
interface Props {
  nombre:
    | 'buscar'
    | 'bolsa'
    | 'whatsapp'
    | 'instagram'
    | 'menu'
    | 'cerrar'
    | 'flecha'
    | 'mas'
    | 'menos'
    | 'papelera'
    | 'check'
    | 'ubicacion'
    | 'reloj'
    | 'sol'
    | 'luna'
    | 'izquierda'
    | 'derecha';
  class?: string;
  tamano?: number;
}
const { nombre, class: clase = '', tamano = 22 } = Astro.props;
const relleno = nombre === 'whatsapp';
---

<svg
  class={clase}
  width={tamano}
  height={tamano}
  viewBox="0 0 24 24"
  fill={relleno ? 'currentColor' : 'none'}
  stroke={relleno ? 'none' : 'currentColor'}
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {nombre === 'buscar' && <><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.6-3.6"></path></>}
  {nombre === 'bolsa' && <><path d="M6 8h12l1 13H5z"></path><path d="M9 8V6a3 3 0 0 1 6 0v2"></path></>}
  {nombre === 'instagram' && <><rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none"></circle></>}
  {nombre === 'menu' && <><path d="M4 7h16"></path><path d="M4 12h16"></path><path d="M4 17h16"></path></>}
  {nombre === 'cerrar' && <><path d="M6 6l12 12"></path><path d="M18 6L6 18"></path></>}
  {nombre === 'flecha' && <><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></>}
  {nombre === 'mas' && <><path d="M12 5v14"></path><path d="M5 12h14"></path></>}
  {nombre === 'menos' && <path d="M5 12h14"></path>}
  {nombre === 'papelera' && <><path d="M5 7h14"></path><path d="M9 7V5h6v2"></path><path d="M7 7l1 13h8l1-13"></path></>}
  {nombre === 'check' && <path d="M5 12.5l4.5 4.5L19 7.5"></path>}
  {nombre === 'ubicacion' && <><path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11z"></path><circle cx="12" cy="10" r="2.4"></circle></>}
  {nombre === 'reloj' && <><circle cx="12" cy="12" r="8.5"></circle><path d="M12 7.5V12l3 2"></path></>}
  {nombre === 'sol' && <><circle cx="12" cy="12" r="4"></circle><path d="M12 3v2"></path><path d="M12 19v2"></path><path d="M3 12h2"></path><path d="M19 12h2"></path><path d="M5.6 5.6l1.4 1.4"></path><path d="M17 17l1.4 1.4"></path><path d="M5.6 18.4L7 17"></path><path d="M17 7l1.4-1.4"></path></>}
  {nombre === 'luna' && <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path>}
  {nombre === 'izquierda' && <path d="M15 5l-7 7 7 7"></path>}
  {nombre === 'derecha' && <path d="M9 5l7 7-7 7"></path>}
  {nombre === 'whatsapp' && (
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"></path>
  )}
