---
import Base from '../layouts/Base.astro';
import Chevron from '../components/Chevron.astro';
---

<Base titulo="Página no encontrada" descripcion="Esta página no existe." noindex>
  <section class="mx-auto max-w-3xl px-4 py-20 text-center md:px-6 md:py-28">
    <div class="flex justify-center"><Chevron ancho={34} /></div>
    <h1 class="mt-6 text-3xl md:text-4xl">Esta vitrina está vacía</h1>
    <p class="mt-3 text-texto-suave">La página que buscas no existe o el perfume cambió de nombre.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/catalogo/" class="btn btn-negro">Ver catálogo</a>
      <a href="/" class="btn btn-borde">Ir al inicio</a>
    </div>
  </section>
</Base>
