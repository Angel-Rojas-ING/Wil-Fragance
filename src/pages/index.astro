---
import Base from '../layouts/Base.astro';
import TarjetaProducto from '../components/TarjetaProducto.astro';
import Chevron from '../components/Chevron.astro';
import Icono from '../components/Icono.astro';
import { tienda, enlaceWhatsApp, mensajes, instagramUrl, instagramConfigurado, pagosConfigurados, textoPagos, ubicacionConfigurada } from '../datos/tienda';
import { destacados, productos, marcas, porSlug, rangoPrecios, rutaImagen, srcsetImagen, rutaPerfume, nombreCompleto, type Producto } from '../lib/catalogo';
import { precio, separarMiles } from '../lib/formato';

const dest = destacados(8);
const diapositivas = dest.length ? dest : productos.slice(0, 1);
const estrella = diapositivas[0];

const marcadasNovedad = productos.filter((p) => p.novedad);
const numericos = productos.every((p) => /^\d+$/.test(p.id));
const recientes = numericos ? [...productos].sort((a, b) => Number(b.id) - Number(a.id)) : [...productos].reverse();
const novedadesGrid = (marcadasNovedad.length ? marcadasNovedad : recientes.filter((p) => !dest.some((d) => d.slug === p.slug))).slice(0, 8);
const subtituloNovedades = marcadasNovedad.length ? 'Recién llegados' : 'Últimos añadidos al catálogo';

const elegir = (slug: string, alternativa: (p: Producto) => boolean) => porSlug.get(slug) ?? productos.find(alternativa) ?? estrella;
const categorias = [
  { href: '/catalogo/?genero=hombre', titulo: 'Hombre', producto: elegir('chanel-bleu-de-chanel-parfum', (p) => p.genero === 'hombre') },
  { href: '/catalogo/?genero=mujer', titulo: 'Mujer', producto: elegir('carolina-herrera-good-girl-edp', (p) => p.genero === 'mujer') },
  { href: '/catalogo/?tipo=arabe', titulo: 'Árabes', producto: elegir('lattafa-asad-edp', (p) => p.tipo === 'árabe') },
  { href: '/catalogo/?tipo=disenador', titulo: 'Diseñador', producto: elegir('yves-saint-laurent-y-edp', (p) => p.tipo === 'diseñador') },
];

const pasos = [
  { titulo: 'Elige', texto: 'Explora el catálogo por género, tipo, marca o precio, o busca por nombre.' },
  { titulo: 'Añade al carrito', texto: 'Se guarda en tu teléfono; puedes seguir mirando y volver cuando quieras.' },
  { titulo: 'Pide por WhatsApp', texto: 'Un botón abre WhatsApp con tu pedido ya escrito. Confirmamos entrega y pago contigo.' },
];

const site = Astro.site ?? new URL('https://wil-fragance.pages.dev');
const { min, max } = rangoPrecios();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Store',
  name: tienda.nombre,
  description: tienda.descripcion,
  url: site.href,
  logo: new URL('/logo/logo-wil-800.png', site).href,
  image: new URL('/img/og-default.jpg', site).href,
  ...(instagramConfigurado ? { sameAs: [instagramUrl] } : {}),
  ...(pagosConfigurados ? { paymentAccepted: tienda.pagos.join(', ') } : {}),
  priceRange: `RD$${separarMiles(min)} - RD$${separarMiles(max)}`,
  address: { '@type': 'PostalAddress', addressCountry: 'DO', ...(ubicacionConfigurada ? { addressLocality: tienda.ubicacion } : {}) },
};
---

<Base
  titulo="Perfumes de diseñador y árabes en República Dominicana"
  descripcion={`${tienda.nombre}: ${productos.length} perfumes de diseñador y árabes con precios en pesos. Elige, arma tu carrito y pide por WhatsApp.`}
  jsonLd={jsonLd}
>
  <!-- Banner: la fachada con el portal; el arco es un carrusel de los destacados -->
  <section class="bg-negro text-blanco">
    <div class="mx-auto grid max-w-7xl gap-6 px-4 pt-5 pb-12 md:grid-cols-2 md:items-center md:gap-12 md:px-6 md:pt-14 md:pb-20">
      <div class="order-2 md:order-1">
        <h1 class="text-[34px] leading-[1.04] text-blanco sm:text-4xl lg:text-[56px]">{tienda.lema}</h1>
        <p class="etiqueta mt-4 text-oro">
          <span class="whitespace-nowrap">Entrega en {tienda.ubicacion}</span>
          <span class="mx-1" aria-hidden="true">·</span>
          <span class="whitespace-nowrap">Pedido por WhatsApp</span>
        </p>
        <p class="mt-4 max-w-md text-[15px] text-blanco/75 md:mt-5 md:text-base">
          Fragancias de las grandes casas y las árabes más buscadas, con precios claros en pesos. Elige, añade al carrito y confirma tu pedido por WhatsApp.
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3 md:mt-7 md:gap-y-4">
          <a href="/catalogo/" class="btn btn-oro">Ver catálogo <Icono nombre="flecha" tamano={16} /></a>
          <a href={enlaceWhatsApp(mensajes.general)} target="_blank" rel="noopener" class="etiqueta border-b border-oro pb-1 text-oro transition-colors hover:text-blanco">
            Pedir por WhatsApp
          </a>
        </div>
        <p class="mt-8 text-sm text-blanco/50">{productos.length} perfumes · {marcas.length} marcas</p>
      </div>

      <div class="order-1 md:order-2" data-carrusel aria-roledescription="carrusel" aria-label="Perfumes destacados">
        <div class="mx-auto grid max-w-sm grid-cols-[auto_1fr_auto] items-end gap-3 md:max-w-md md:gap-5">
          <span class="columna h-[60%] md:w-14 md:[--hueco:18px]" aria-hidden="true"></span>
          <div class="arco arco--limpio">
            <ul class="pista" data-pista>
              {diapositivas.map((p, i) => (
                <li
                  data-nombre={p.nombre}
                  data-marca={p.marca}
                  data-precio={precio(p.precio)}
                  data-url={rutaPerfume(p)}
                  aria-label={`${i + 1} de ${diapositivas.length}: ${nombreCompleto(p)}`}
                >
                  <a href={rutaPerfume(p)} aria-label={`Ver ${nombreCompleto(p)}`}>
                    <img
                      src={rutaImagen(p.imagen, 800)}
                      srcset={srcsetImagen(p.imagen)}
                      sizes="(min-width: 768px) 40vw, 80vw"
                      width="800"
                      height="800"
                      alt={nombreCompleto(p)}
                      loading={i === 0 ? 'eager' : 'lazy'}
                      fetchpriority={i === 0 ? 'high' : 'auto'}
                      decoding={i === 0 ? 'sync' : 'async'}
                    />
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <span class="columna h-[60%] md:w-14 md:[--hueco:18px]" aria-hidden="true"></span>
        </div>

        <p class="mt-4 text-center text-sm text-blanco/80 md:mt-5" data-leyenda aria-live="off">
          <a href={rutaPerfume(estrella)} class="hover:text-oro" data-leyenda-enlace>
            <span class="font-bold text-blanco" data-leyenda-nombre>{estrella.nombre}</span>
            <span class="etiqueta ml-2 text-[11px] text-oro" data-leyenda-marca>{estrella.marca}</span>
          </a>
          <span class="mx-2 text-blanco/40" aria-hidden="true">·</span>
          <span data-leyenda-precio>{precio(estrella.precio)}</span>
        </p>

        {diapositivas.length > 1 && (
          <div class="mt-1 flex items-center justify-center gap-3 md:mt-3">
            <button type="button" class="grid h-11 w-11 place-items-center text-blanco/70 transition-colors hover:text-oro" data-anterior aria-label="Anterior">
              <Icono nombre="izquierda" />
            </button>
            <div class="flex items-center">
              {diapositivas.map((p, i) => (
                <button type="button" class="grid h-11 w-8 place-items-center" data-punto aria-label={`Ir a ${nombreCompleto(p)}`} aria-current={i === 0 ? 'true' : 'false'}>
                  <span class="punto"></span>
                </button>
              ))}
            </div>
            <button type="button" class="grid h-11 w-11 place-items-center text-blanco/70 transition-colors hover:text-oro" data-siguiente aria-label="Siguiente">
              <Icono nombre="derecha" />
            </button>
            <button type="button" class="ml-1 grid h-11 w-11 place-items-center text-blanco/70 transition-colors hover:text-oro" data-pausa aria-pressed="false" aria-label="Pausar el carrusel">
              <Icono nombre="pausa" class="cuando-activo" tamano={18} />
              <Icono nombre="reproducir" class="cuando-pausado" tamano={18} />
            </button>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Categorías: cuatro vitrinas -->
  <section class="mx-auto max-w-7xl px-4 py-12 md:px-6 md:py-16">
    <h2 class="text-2xl md:text-3xl">Explora</h2>
    <div class="mt-7 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-5">
      {categorias.map((c) => (
        <a href={c.href} class="group block text-center">
          <div class="arco">
            <img
              src={rutaImagen(c.producto.imagen, 400)}
              srcset={srcsetImagen(c.producto.imagen)}
              sizes="(min-width: 768px) 22vw, 45vw"
              width="400"
              height="400"
              alt=""
              loading="lazy"
              decoding="async"
            />
          </div>
          <span class="etiqueta mt-3 block text-tinta transition-colors group-hover:text-acento">{c.titulo}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Destacados -->
  <section class="bg-fondo-suave">
    <div class="mx-auto max-w-7xl px-4 py-12 md:px-6 md:py-16">
      <div class="flex items-end justify-between gap-4">
        <div>
          <h2 class="text-2xl md:text-3xl">Destacados</h2>
          <p class="etiqueta mt-2 text-acento">Selección de la casa</p>
        </div>
        <a href="/catalogo/" class="etiqueta hidden text-tinta transition-colors hover:text-acento sm:block">Ver todo el catálogo</a>
      </div>
      <div class="mt-7 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-5">
        {dest.map((p) => <TarjetaProducto producto={p} />)}
      </div>
      <a href="/catalogo/" class="btn btn-borde mt-8 w-full sm:hidden">Ver todo el catálogo</a>
    </div>
  </section>

  <!-- Cómo pedir -->
  <section class="mx-auto max-w-7xl px-4 py-12 md:px-6 md:py-16">
    <h2 class="text-2xl md:text-3xl">Así de fácil</h2>
    <ol class="mt-8 grid gap-6 md:grid-cols-3 md:gap-8">
      {pasos.map((paso, i) => (
        <li class="border-t border-oro pt-5">
          <h3 class="text-lg"><span class="text-acento">{i + 1}.</span> {paso.titulo}</h3>
          <p class="mt-2 text-sm text-texto-suave">{paso.texto}</p>
        </li>
      ))}
    </ol>
    <ul class="mt-10 grid gap-3 border border-linea bg-fondo-suave p-5 text-sm sm:grid-cols-3 md:p-6">
      <li class="flex items-center gap-3"><Chevron ancho={18} /> Pedido y confirmación por WhatsApp</li>
      <li class="flex items-center gap-3"><Chevron ancho={18} /> Entrega en {tienda.ubicacion}</li>
      <li class="flex items-center gap-3"><Chevron ancho={18} /> {pagosConfigurados ? `Pago por ${textoPagos}` : 'Pago acordado por WhatsApp'}</li>
    </ul>
  </section>

  <!-- Novedades -->
  <section class="bg-fondo-suave">
    <div class="mx-auto max-w-7xl px-4 py-12 md:px-6 md:py-16">
      <h2 class="text-2xl md:text-3xl">Novedades</h2>
      <p class="etiqueta mt-2 text-acento">{subtituloNovedades}</p>
      <div class="mt-7 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-5">
        {novedadesGrid.map((p) => <TarjetaProducto producto={p} />)}
      </div>
    </div>
  </section>

  <!-- Marcas -->
  <section class="mx-auto max-w-7xl px-4 py-12 md:px-6 md:py-16">
    <h2 class="text-2xl md:text-3xl">Marcas</h2>
    <p class="etiqueta mt-2 text-acento">{marcas.length} casas</p>
    <div class="mt-6 flex flex-wrap gap-2">
      {marcas.map((m) => (
        <a href={`/catalogo/?marca=${encodeURIComponent(m.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase())}`} class="chip">{m}</a>
      ))}
    </div>
  </section>

  <!-- Cierre -->
  <section class="bg-negro text-blanco">
    <div class="mx-auto max-w-7xl px-4 py-14 md:px-6 md:py-20">
      <div class="separador separador--oscuro"><Chevron ancho={30} /></div>
      <div class="mt-10 grid gap-8 md:grid-cols-[1fr_auto] md:items-center">
        <div>
          <h2 class="text-2xl text-blanco md:text-3xl">¿Buscas un perfume que no ves aquí?</h2>
          <p class="mt-3 max-w-lg text-blanco/70">Escríbenos y te decimos si lo conseguimos. También te ayudamos a elegir si vas a regalar.</p>
        </div>
        <a href={enlaceWhatsApp(mensajes.general)} target="_blank" rel="noopener" class="btn btn-oro">
          <Icono nombre="whatsapp" /> Escríbenos por WhatsApp
        </a>
      </div>
    </div>
  </section>
  <script src="../scripts/carrusel.ts"></script>
</Base>
